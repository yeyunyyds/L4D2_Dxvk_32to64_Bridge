+reshade::input::~input() {
+ if(!_ldb_context)return;
+ const std::lock_guard<std::mutex> publication(_ldb_context->publication);
+ void* owner=_ldb_owner;
+ if(_ldb_context->owner.compare_exchange_strong(owner,nullptr)) {
+  ldb_reshade::publishCapture(*_ldb_context->data,_ldb_epoch,0,GetTickCount64());
+  _ldb_context->data->epoch.fetch_add(1,std::memory_order_release);
+ }
+}
+std::shared_ptr<reshade::input> reshade::input::ldb_register(window_handle window,void* runtime) {
+ auto* c=ldb_reshade::context.load(std::memory_order_acquire);if(!c || !window || !c->alive())return nullptr;
+ const std::lock_guard<std::mutex> publication(c->publication);
+ auto& data=*c->data;
+ const auto hwnd=static_cast<HWND>(window);
+ DWORD pid=0;GetWindowThreadProcessId(hwnd,&pid);
+ if(pid!=data.clientPid || static_cast<uint32_t>(reinterpret_cast<uintptr_t>(hwnd))!=data.window.load(std::memory_order_acquire))return nullptr;
+ void* empty=nullptr;if(!c->owner.compare_exchange_strong(empty,runtime))return nullptr;
+ auto result=std::make_shared<input>(window);
+ result->_ldb_context=c;result->_ldb_owner=runtime;result->_ldb_epoch=data.epoch.fetch_add(1,std::memory_order_acq_rel)+1;
+ result->_text_input.reserve(ldb_reshade::capacity);
+ ldb_reshade::publishCapture(data,result->_ldb_epoch,0,GetTickCount64());
+ LOG(INFO)<<"LDB_EXTERNAL_INPUT event=runtime-bound epoch="<<result->_ldb_epoch<<" build="<<ldb_reshade::experimentalBuild;
+ return result;
+}
+void reshade::input::ldb_begin_frame() {
+ if(!_ldb_context)return;
+ auto& data=*_ldb_context->data;
+ const auto now=GetTickCount64(),published=data.sourceTime.load(std::memory_order_acquire);
+ const uint32_t flags=data.sourceFlags.load(std::memory_order_acquire);
+ const bool focus=(flags & ldb_reshade::Focused)!=0 && _ldb_context->alive() && !data.fault.load(std::memory_order_acquire)
+  && published<=now && now-published<=1000 && _ldb_epoch==data.epoch.load(std::memory_order_acquire);
+ const std::unique_lock<std::shared_mutex> lock(_mutex);
+ if(!focus){std::fill_n(_keys,256,uint8_t(0));_text_input.clear();_mouse_wheel_delta=0;_block_mouse=_block_keyboard=false;}
+ if(_ldb_epoch==data.epoch.load(std::memory_order_acquire)) ldb_reshade::consume(data,_ldb_epoch,[&](const ldb_reshade::Event& e){
+  if(!focus)return;
+  switch(static_cast<ldb_reshade::Kind>(e.kind)) {
+  case ldb_reshade::Kind::Key:
+  case ldb_reshade::Kind::Button:
+   if(e.code==0 || e.code>=256){data.fault.store(3,std::memory_order_release);return;}
+   _keys[e.code]=(e.flags & ldb_reshade::Down)?0x88:0x08;_keys_time[e.code]=e.time;break;
+  case ldb_reshade::Kind::Wheel:_mouse_wheel_delta=static_cast<short>(_mouse_wheel_delta+static_cast<short>(e.x)/WHEEL_DELTA);break;
+  case ldb_reshade::Kind::Text:
+   if(e.code>65535){data.fault.store(3,std::memory_order_release);return;}
+   _text_input+=static_cast<wchar_t>(e.code);break;
+  case ldb_reshade::Kind::Focus:
+   if(!(e.flags & ldb_reshade::Focused)){std::fill_n(_keys,256,uint8_t(0));_text_input.clear();}break;
+  default:data.fault.store(3,std::memory_order_release);break;
+  }
+ });
+ if(data.fault.load(std::memory_order_acquire)){std::fill_n(_keys,256,uint8_t(0));_block_mouse=_block_keyboard=false;_ldb_focus=false;return;}
+ _ldb_focus=focus;
+ const auto position=data.position.load(std::memory_order_acquire);
+ _mouse_position[0]=static_cast<unsigned int>(ldb_reshade::x(position));_mouse_position[1]=static_cast<unsigned int>(ldb_reshade::y(position));
+ _keys[VK_CAPITAL]=static_cast<uint8_t>((_keys[VK_CAPITAL]&~1u)|((flags & ldb_reshade::CapsLock)?1u:0u));
+ const unsigned vk[]={VK_MENU,VK_CONTROL,VK_SHIFT};const unsigned state[]={ldb_reshade::Alt,ldb_reshade::Ctrl,ldb_reshade::Shift};
+ for(unsigned i=0;i<3;++i){_keys[vk[i]]=static_cast<uint8_t>((_keys[vk[i]]&0x08)|((focus && (flags & state[i]))?0x80:0));_keys_time[vk[i]]=static_cast<DWORD>(now);}
+}
+void reshade::input::ldb_capture(bool open) {
+ if(!_ldb_context)return;
+ const std::lock_guard<std::mutex> publication(_ldb_context->publication);
+ if(_ldb_context->owner.load()!=_ldb_owner || _ldb_context->data->epoch.load()!=_ldb_epoch)return;
+ const uint32_t mask=(open && _ldb_focus && !_ldb_context->data->fault.load(std::memory_order_acquire))?7u:0u;
+ ldb_reshade::publishCapture(*_ldb_context->data,_ldb_epoch,mask,GetTickCount64());
+}
